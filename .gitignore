# ============================================================
# HF2026 UAV Simulation Project - .gitignore
# Python工程标准忽略规则 + 无人机仿真项目规范
# ============================================================

# --- Python 缓存与编译文件 ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- 打包与分发 ---
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- 虚拟环境 ---
venv/
env/
ENV/
.venv/
.env
env.bak/
venv.bak/

# --- IDE 配置 ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.classpath
.factorypath
*.code-workspace

# --- 日志文件 ---
*.log
logs/
sim_test_log/*.json
sim_test_log/*.txt
sim_test_log/*.csv

# --- 数据集 (仅本地, 打包时移除) ---
dataset/*
!dataset/.gitkeep

# --- 仿真输出 ---
output/
run/
*.evaluation.json
*.pid
*.score

# --- UE 渲染截图 ---
Saved/
Saved/Screenshots/
*.bmp

# --- 离线依赖包 (大文件, 不入库) ---
install_offline/wheels/*.whl
install_offline/wheels/*.tar.gz

# --- 临时文件 ---
*.tmp
*.bak
*.cache
*.pid

# --- 操作系统 ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
Dockerfile

# --- Jupyter Notebook ---
.ipynb_checkpoints/
*.ipynb

# --- 测试与覆盖率 ---
.pytest_cache/
.coverage
.htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# --- 类型检查 ---
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
